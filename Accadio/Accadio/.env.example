# Database URL (SQLite file database for local dev, or postgresql://... for Supabase / Neon / Railway)
DATABASE_URL="file:./dev.db"

# Storage Provider: "local" (default) | "cloudinary" | "s3"
STORAGE_PROVIDER="local"

# Cloudinary credentials (optional - active if STORAGE_PROVIDER="cloudinary")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# S3 / Supabase Storage credentials (optional - active if STORAGE_PROVIDER="s3")
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""

# Email Notifications (Optional - will log to server console if left empty)
# Resend API Key:
RESEND_API_KEY=""
# OR SMTP Credentials:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Accadio Inquiries <noreply@meruglobal.org>"

# Admin Notification recipient
ADMIN_NOTIFICATION_EMAIL="admin@meruglobal.org"
