# Server Port
PORT=5000
FRONTEND_URL="http://localhost:3000"

# Database URL (Supabase PostgreSQL)
DATABASE_URL="file:./dev.db"

# Storage Provider: "local" (default) | "cloudinary" | "s3"
STORAGE_PROVIDER="local"

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email Notifications (Optional - leaves empty for console logging)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Accadio Inquiries <noreply@meruglobal.org>"
ADMIN_NOTIFICATION_EMAIL="admin@meruglobal.org"
